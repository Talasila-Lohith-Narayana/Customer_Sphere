DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=YOUR_EXISTING_DATABASE_NAME
ANALYTICS_DB_NAME=YOUR_ANALYTICS_DATABASE_NAME
# Required for Nova exploratory SQL. Use a distinct MySQL account with SELECT-only
# grants on approved business tables.
NOVA_READONLY_DB_USER=nova_readonly
NOVA_READONLY_DB_PASSWORD=YOUR_NOVA_READONLY_MYSQL_PASSWORD
# Optional overrides; otherwise DB_HOST, DB_PORT, and DB_NAME are reused.
# NOVA_READONLY_DB_HOST=localhost
# NOVA_READONLY_DB_PORT=3306
# NOVA_READONLY_DB_NAME=YOUR_EXISTING_DATABASE_NAME
JWT_SECRET_KEY=
# Set false only for local HTTP development; production must use HTTPS and true.
AUTH_COOKIE_SECURE=false
# Use "none" only for cross-site frontend/API deployments, with Secure enabled.
AUTH_COOKIE_SAMESITE=lax
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
VIEWER_USERNAME=analyst
VIEWER_PASSWORD=
# Explicitly enable only when creating the initial default accounts
ALLOW_BOOTSTRAP_USERS=false
# Optional shared storage for multi-worker deployments; requires Redis
RATE_LIMIT_REDIS_URL=
# Comma-separated trusted proxy IPs/CIDRs; only then is X-Forwarded-For used
TRUSTED_PROXY_HOSTS=

# Optional OpenRouter-powered aggregate analytics assistant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Customer Intelligence source code and generated ML artifacts
CUSTOMER_INTELLIGENCE_ROOT="/path/to/customer-intelligence-platform"
# Optional: defaults to $CUSTOMER_INTELLIGENCE_ROOT/outputs
CUSTOMER_INTELLIGENCE_OUTPUTS_DIR=
# Optional: artifact path, project root, or models directory
MODEL_PATH=
