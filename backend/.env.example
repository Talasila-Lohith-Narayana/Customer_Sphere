DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=YOUR_EXISTING_DATABASE_NAME
ANALYTICS_DB_NAME=YOUR_ANALYTICS_DATABASE_NAME
JWT_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
VIEWER_USERNAME=analyst
VIEWER_PASSWORD=
# Explicitly enable only when creating the initial default accounts
ALLOW_BOOTSTRAP_USERS=false
# Optional shared storage for multi-worker deployments; requires Redis
RATE_LIMIT_REDIS_URL=
# Comma-separated trusted proxy IPs/CIDRs; only then is X-Forwarded-For used
TRUSTED_PROXY_HOSTS=

# Customer Intelligence source code and generated ML artifacts
CUSTOMER_INTELLIGENCE_ROOT="/path/to/customer-intelligence-platform"
# Optional: defaults to $CUSTOMER_INTELLIGENCE_ROOT/outputs
CUSTOMER_INTELLIGENCE_OUTPUTS_DIR=
# Optional: artifact path, project root, or models directory
MODEL_PATH=
